@inherits LayoutComponentBase
@inject IJSRuntime JS

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4 d-flex justify-content-between align-items-center">
            <div class="d-flex align-items-center gap-2">
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                    <i class="bi bi-hdd-network me-1"></i> Modo Local-First Activo
                </span>
                <span class="text-secondary small d-none d-md-inline">SQLite DB Conectada</span>
            </div>

            <div class="d-flex align-items-center gap-3">
                <button class="btn btn-outline-secondary btn-sm rounded-pill px-3" @onclick="ToggleTema">
                    <i class="bi @(esTemaOscuro ? "bi-sun-fill text-warning" : "bi-moon-stars-fill text-primary") me-1"></i>
                    @(esTemaOscuro ? "Modo Claro" : "Modo Oscuro")
                </button>
            </div>
        </div>

        <article class="content px-4 py-3">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    Ha ocurrido un error inesperado en la aplicación.
    <a href="." class="reload">Recargar</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool esTemaOscuro = true;

    private async Task ToggleTema()
    {
        esTemaOscuro = !esTemaOscuro;
        string tema = esTemaOscuro ? "dark" : "light";
        await JS.InvokeVoidAsync("cambiarTema", tema);
    }
}
