@page "/"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject NavigationManager Nav

<PageTitle>Dashboard - PlagScan Pro</PageTitle>

<div class="container-fluid p-0">
    <!-- Hero Banner -->
    <div class="card card-modern p-4 mb-4 border-primary">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <span class="badge bg-primary text-uppercase mb-2">Plataforma Local-First</span>
                <h1 class="fw-bold tracking-tight mb-2">Sistema Analizador de Plagio e Inteligencia Artificial</h1>
                <p class="text-secondary mb-3">
                    Auditoría de código fuente en C#, comparación matricial Levenshtein, detección de patrones generados por LLMs, inspección de metadatos NTFS y generación automatizada de cuestionarios de defensa oral.
                </p>
                <div class="d-flex gap-2 flex-wrap">
                    <button class="btn btn-primary" @onclick="@(() => Nav.NavigateTo("analisis"))">
                        <i class="bi bi-file-earmark-code me-1"></i> Ir al Panel de Análisis
                    </button>
                    <button class="btn btn-outline-secondary" @onclick="@(() => Nav.NavigateTo("grupos"))">
                        <i class="bi bi-people me-1"></i> Administrar Grupos
                    </button>
                </div>
            </div>
            <div class="col-lg-4 text-center d-none d-lg-block">
                <i class="bi bi-shield-lock-fill text-primary" style="font-size: 7rem; opacity: 0.85;"></i>
            </div>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card card-modern p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-primary-subtle text-primary fs-3">
                        <i class="bi bi-collection-fill"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold">Grupos Activos</div>
                        <h3 class="fw-bold m-0 text-primary">@totalGrupos</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-modern p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-success-subtle text-success fs-3">
                        <i class="bi bi-person-check-fill"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold">Estudiantes</div>
                        <h3 class="fw-bold m-0 text-success">@totalEstudiantes</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-modern p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-danger-subtle text-danger fs-3">
                        <i class="bi bi-search"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold">Análisis Realizados</div>
                        <h3 class="fw-bold m-0 text-danger">@totalAnalisis</h3>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card card-modern p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="p-3 rounded-circle bg-warning-subtle text-warning fs-3">
                        <i class="bi bi-robot"></i>
                    </div>
                    <div>
                        <div class="text-secondary small fw-semibold">Alertas de IA</div>
                        <h3 class="fw-bold m-0 text-warning">@alertasIA</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Módulos de Acceso Rápido -->
    <div class="row g-4">
        <div class="col-md-6 col-lg-3">
            <div class="card card-modern p-4 h-100 cursor-pointer" @onclick="@(() => Nav.NavigateTo("grupos"))">
                <i class="bi bi-people-fill text-primary fs-2 mb-2"></i>
                <h5 class="fw-bold mb-1">Módulo 1: Grupos & Estudiantes</h5>
                <p class="text-secondary small mb-0">Gestión de cohortes, asignación de ciclos (1, 2, 3), importación masiva por texto y respaldos ZIP.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card card-modern p-4 h-100 cursor-pointer" @onclick="@(() => Nav.NavigateTo("analisis"))">
                <i class="bi bi-columns-gap text-info fs-2 mb-2"></i>
                <h5 class="fw-bold mb-1">Módulo 2: Panel de Análisis</h5>
                <p class="text-secondary small mb-0">Drag & Drop, Blind Grading (Modo a Ciegas), visor diferencial de código lado a lado y Levenshtein.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card card-modern p-4 h-100 cursor-pointer" @onclick="@(() => Nav.NavigateTo("resultados"))">
                <i class="bi bi-patch-question-fill text-success fs-2 mb-2"></i>
                <h5 class="fw-bold mb-1">Módulo 3: Resultados & Quiz</h5>
                <p class="text-secondary small mb-0">Inspección forense de Windows OS, métricas de plagio e IA y generación de fichas para examen oral.</p>
            </div>
        </div>

        <div class="col-md-6 col-lg-3">
            <div class="card card-modern p-4 h-100 cursor-pointer" @onclick="@(() => Nav.NavigateTo("historico"))">
                <i class="bi bi-graph-up-arrow text-warning fs-2 mb-2"></i>
                <h5 class="fw-bold mb-1">Módulo 4: Tendencias</h5>
                <p class="text-secondary small mb-0">Evolución de plagio y patrones generados por IA a lo largo de Cómputo 1, 2 y 3 con gráficos visuales.</p>
            </div>
        </div>
    </div>
</div>

@code {
    private int totalGrupos = 0;
    private int totalEstudiantes = 0;
    private int totalAnalisis = 0;
    private int alertasIA = 0;

    protected override async Task OnInitializedAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        totalGrupos = await db.grupos.CountAsync();
        totalEstudiantes = await db.Estudiantes.CountAsync();
        totalAnalisis = await db.Evaluaciones.CountAsync();
        alertasIA = await db.Evaluaciones.CountAsync(h => h.PorcentajeIA >= 50);
    }
}
