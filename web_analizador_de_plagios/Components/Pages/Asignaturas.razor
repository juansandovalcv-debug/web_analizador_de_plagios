@page "/asignaturas"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Asignaturas - PlagScan Pro</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-book text-primary me-2"></i>Gestión de Asignaturas</h2>
            <p class="text-secondary mb-0">Catálogo de materias asociadas a las evaluaciones de código.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="@(() => mensaje = string.Empty)"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card card-modern p-4">
                <h5 class="fw-bold mb-3">@(editandoId == 0 ? "Nueva Asignatura" : "Editar Asignatura")</h5>
                <EditForm Model="modelo" OnValidSubmit="GuardarAsignatura">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Código</label>
                        <InputText class="form-control" @bind-Value="modelo.Codigo" placeholder="Ej. PROG-101" />
                        <ValidationMessage For="@(() => modelo.Codigo)" class="text-danger small" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre de la Asignatura</label>
                        <InputText class="form-control" @bind-Value="modelo.Nombre" placeholder="Ej. Programación I" />
                        <ValidationMessage For="@(() => modelo.Nombre)" class="text-danger small" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Unidades Valorativas (UV)</label>
                        <InputNumber class="form-control" @bind-Value="modelo.UnidadesValorativas" />
                        <ValidationMessage For="@(() => modelo.UnidadesValorativas)" class="text-danger small" />
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-save me-1"></i> @(editandoId == 0 ? "Guardar" : "Actualizar")
                        </button>
                        @if (editandoId != 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelarEdicion">Cancelar</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-modern p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
                    <h5 class="fw-bold m-0">Listado de Asignaturas (@AsignaturasFiltradas.Count())</h5>
                    <div class="input-group" style="max-width: 300px;">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por código o nombre..."
                               @bind="filtroBusqueda" @bind:event="oninput" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Código</th>
                                <th>Nombre</th>
                                <th>UV</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!AsignaturasFiltradas.Any())
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-secondary py-4">No se encontraron asignaturas.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var a in AsignaturasFiltradas)
                                {
                                    <tr>
                                        <td><span class="badge bg-primary-subtle text-primary">@a.Codigo</span></td>
                                        <td class="fw-semibold">@a.Nombre</td>
                                        <td>@a.UnidadesValorativas</td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => Editar(a))">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="@(() => Eliminar(a.IdAsignatura))">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Asignatura> lista = new();
    private Asignatura modelo = new();
    private int editandoId = 0;
    private string filtroBusqueda = string.Empty;
    private string mensaje = string.Empty;
    private bool esError = false;

    private IEnumerable<Asignatura> AsignaturasFiltradas => string.IsNullOrWhiteSpace(filtroBusqueda)
        ? lista
        : lista.Where(a =>
            a.Codigo.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
            a.Nombre.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        lista = await db.Asignaturas.OrderBy(a => a.Codigo).ToListAsync();
    }

    private async Task GuardarAsignatura()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var codigoNorm = modelo.Codigo.Trim().ToUpperInvariant();
        bool duplicado = await db.Asignaturas.AnyAsync(a => a.Codigo.ToUpper() == codigoNorm && a.IdAsignatura != editandoId);
        if (duplicado)
        {
            esError = true;
            mensaje = "Ya existe una asignatura con ese código.";
            return;
        }

        if (editandoId == 0)
        {
            db.Asignaturas.Add(new Asignatura
            {
                Codigo = codigoNorm,
                Nombre = modelo.Nombre.Trim(),
                UnidadesValorativas = modelo.UnidadesValorativas
            });
            mensaje = "Asignatura registrada correctamente.";
        }
        else
        {
            var existente = await db.Asignaturas.FindAsync(editandoId);
            if (existente != null)
            {
                existente.Codigo = codigoNorm;
                existente.Nombre = modelo.Nombre.Trim();
                existente.UnidadesValorativas = modelo.UnidadesValorativas;
            }
            mensaje = "Asignatura actualizada correctamente.";
        }

        await db.SaveChangesAsync();
        esError = false;
        CancelarEdicion();
        await Cargar();
    }

    private void Editar(Asignatura a)
    {
        editandoId = a.IdAsignatura;
        modelo = new Asignatura
        {
            IdAsignatura = a.IdAsignatura,
            Codigo = a.Codigo,
            Nombre = a.Nombre,
            UnidadesValorativas = a.UnidadesValorativas
        };
    }

    private async Task Eliminar(int id)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var item = await db.Asignaturas.FindAsync(id);
        if (item != null)
        {
            db.Asignaturas.Remove(item);
            await db.SaveChangesAsync();
            esError = false;
            mensaje = "Asignatura eliminada.";
            await Cargar();
        }
    }

    private void CancelarEdicion()
    {
        editandoId = 0;
        modelo = new Asignatura();
    }
}
