@page "/docentes"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory

<PageTitle>Docentes - PlagScan Pro</PageTitle>

<div class="container-fluid p-0">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1"><i class="bi bi-person-badge text-primary me-2"></i>Gestión de Docentes</h2>
            <p class="text-secondary mb-0">Registro, edición, búsqueda interactiva y control de docentes evaluadores.</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensaje))
    {
        <div class="alert @(esError ? "alert-danger" : "alert-success") alert-dismissible fade show">
            @mensaje
            <button type="button" class="btn-close" @onclick="@(() => mensaje = string.Empty)"></button>
        </div>
    }

    <div class="row g-4">
        <div class="col-lg-4">
            <div class="card card-modern p-4">
                <h5 class="fw-bold mb-3">@(editandoId == 0 ? "Nuevo Docente" : "Editar Docente")</h5>
                <EditForm Model="modelo" OnValidSubmit="GuardarDocente">
                    <DataAnnotationsValidator />
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Nombre Completo</label>
                        <InputText class="form-control" @bind-Value="modelo.NombreCompleto" placeholder="Ej. Ing. Carlos Méndez" />
                        <ValidationMessage For="@(() => modelo.NombreCompleto)" class="text-danger small" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Correo Institucional</label>
                        <InputText class="form-control" @bind-Value="modelo.Correo" placeholder="cmendez@universidad.edu" />
                        <ValidationMessage For="@(() => modelo.Correo)" class="text-danger small" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Especialidad</label>
                        <InputText class="form-control" @bind-Value="modelo.Especialidad" placeholder="Ej. Programación / IA" />
                        <ValidationMessage For="@(() => modelo.Especialidad)" class="text-danger small" />
                    </div>
                    <div class="form-check mb-3">
                        <InputCheckbox class="form-check-input" @bind-Value="modelo.Activo" id="chkActivo" />
                        <label class="form-check-label" for="chkActivo">Docente Activo</label>
                    </div>
                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary flex-grow-1">
                            <i class="bi bi-save me-1"></i> @(editandoId == 0 ? "Guardar" : "Actualizar")
                        </button>
                        @if (editandoId != 0)
                        {
                            <button type="button" class="btn btn-outline-secondary" @onclick="CancelarEdicion">Cancelar</button>
                        }
                    </div>
                </EditForm>
            </div>
        </div>

        <div class="col-lg-8">
            <div class="card card-modern p-4">
                <div class="d-flex justify-content-between align-items-center mb-3 gap-3 flex-wrap">
                    <h5 class="fw-bold m-0">Listado de Docentes (@DocentesFiltrados.Count())</h5>
                    <div class="input-group" style="max-width: 320px;">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por nombre, correo o especialidad..."
                               @bind="filtroBusqueda" @bind:event="oninput" />
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Correo</th>
                                <th>Especialidad</th>
                                <th>Estado</th>
                                <th class="text-end">Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (!DocentesFiltrados.Any())
                            {
                                <tr>
                                    <td colspan="5" class="text-center text-secondary py-4">No se encontraron docentes.</td>
                                </tr>
                            }
                            else
                            {
                                @foreach (var d in DocentesFiltrados)
                                {
                                    <tr>
                                        <td class="fw-semibold">@d.NombreCompleto</td>
                                        <td>@d.Correo</td>
                                        <td>@d.Especialidad</td>
                                        <td>
                                            <span class="badge @(d.Activo ? "bg-success" : "bg-secondary")">
                                                @(d.Activo ? "Activo" : "Inactivo")
                                            </span>
                                        </td>
                                        <td class="text-end">
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="@(() => Editar(d))">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <button class="btn btn-sm btn-outline-danger" @onclick="@(() => Eliminar(d.IdDocente))">
                                                <i class="bi bi-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<Docente> lista = new();
    private Docente modelo = new();
    private int editandoId = 0;
    private string filtroBusqueda = string.Empty;
    private string mensaje = string.Empty;
    private bool esError = false;

    private IEnumerable<Docente> DocentesFiltrados => string.IsNullOrWhiteSpace(filtroBusqueda)
        ? lista
        : lista.Where(d =>
            d.NombreCompleto.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
            d.Correo.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase) ||
            d.Especialidad.Contains(filtroBusqueda, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync() => await Cargar();

    private async Task Cargar()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        lista = await db.Docentes.OrderBy(d => d.NombreCompleto).ToListAsync();
    }

    private async Task GuardarDocente()
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var correoNorm = modelo.Correo.Trim().ToLowerInvariant();
        bool duplicado = await db.Docentes.AnyAsync(d => d.Correo.ToLower() == correoNorm && d.IdDocente != editandoId);
        if (duplicado)
        {
            esError = true;
            mensaje = "Ya existe un docente registrado con ese correo institucional.";
            return;
        }

        if (editandoId == 0)
        {
            db.Docentes.Add(new Docente
            {
                NombreCompleto = modelo.NombreCompleto.Trim(),
                Correo = correoNorm,
                Especialidad = modelo.Especialidad.Trim(),
                Activo = modelo.Activo
            });
            mensaje = "Docente registrado correctamente.";
        }
        else
        {
            var existente = await db.Docentes.FindAsync(editandoId);
            if (existente != null)
            {
                existente.NombreCompleto = modelo.NombreCompleto.Trim();
                existente.Correo = correoNorm;
                existente.Especialidad = modelo.Especialidad.Trim();
                existente.Activo = modelo.Activo;
            }
            mensaje = "Docente actualizado correctamente.";
        }

        await db.SaveChangesAsync();
        esError = false;
        CancelarEdicion();
        await Cargar();
    }

    private void Editar(Docente d)
    {
        editandoId = d.IdDocente;
        modelo = new Docente
        {
            IdDocente = d.IdDocente,
            NombreCompleto = d.NombreCompleto,
            Correo = d.Correo,
            Especialidad = d.Especialidad,
            Activo = d.Activo
        };
    }

    private async Task Eliminar(int id)
    {
        using var db = await DbFactory.CreateDbContextAsync();
        var doc = await db.Docentes.FindAsync(id);
        if (doc != null)
        {
            db.Docentes.Remove(doc);
            await db.SaveChangesAsync();
            esError = false;
            mensaje = "Docente eliminado.";
            await Cargar();
        }
    }

    private void CancelarEdicion()
    {
        editandoId = 0;
        modelo = new Docente();
    }
}
