    private async Task ProcesarCargaMasivaAsync()
    {
        if (string.IsNullOrWhiteSpace(textoCargaMasiva)) return;

        try
        {
            var lineas = textoCargaMasiva.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            int agregados = 0;
            int duplicados = 0;

            await using var db = await DbFactory.CreateDbContextAsync();

            foreach (var l in lineas)
            {
                var partes = l.Split(',', StringSplitOptions.TrimEntries);
                if (partes.Length >= 2)
                {
                    string carnet = partes[0].ToUpperInvariant();
                    string nombre = partes[1];

                    bool existe = await db.Estudiantes.AnyAsync(e => e.Carnet == carnet && e.IdGrupo == grupoDestinoMasivoId);
                    if (!existe)
                    {
                        db.Estudiantes.Add(new Estudiante
                        {
                            Carnet = carnet,
                            NombreCompleto = nombre,
                            IdGrupo = grupoDestinoMasivoId
                        });
                        agregados++;
                    }
                    else
                    {
                        duplicados++;
                    }
                }
            }

            await db.SaveChangesAsync();
            textoCargaMasiva = string.Empty;
            mensajeAlerta = $"Carga completada: {agregados} alumnos importados. ({duplicados} omitidos por ya existir).";
            tipoAlerta = "success";
            pestanaActiva = "estudiantes";

            await CargarEstudiantesAsync();
            await CargarGruposAsync();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error en carga masiva: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

    private async Task ExportarZipGrupoAsync()
    {
        if (grupoExportarId == 0) return;

        try
        {
            byte[] zipBytes = await GestorRespaldos.ExportarGrupoZipAsync(grupoExportarId);
            string base64 = Convert.ToBase64String(zipBytes);
            string nombreArchivo = $"respaldo_grupo_{grupoExportarId}_{DateTime.Now:yyyyMMdd_HHmm}.zip";

            await JS.InvokeVoidAsync("descargarBytesZip", nombreArchivo, base64);
            mensajeAlerta = $"Copia de seguridad descargada exitosamente ({zipBytes.Length / 1024.0:F1} KB).";
            tipoAlerta = "success";
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al generar respaldo ZIP: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

    private async Task ImportarZipGrupoAsync(InputFileChangeEventArgs e)
    {
        procesandoZip = true;
        mensajeAlerta = null;

        try
        {
            var file = e.File;
            if (file == null) return;

            using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            string msg = await GestorRespaldos.ImportarGrupoZipAsync(stream);

            mensajeAlerta = msg;
            tipoAlerta = "success";
            await CargarGruposAsync();
            await CargarEstudiantesAsync();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Falla al restaurar archivo .ZIP: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            procesandoZip = false;
        }
    }
