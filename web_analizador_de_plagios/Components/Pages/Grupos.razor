    private void AbrirModalEditarEstudiante(Estudiante e)
    {
        esEdicionEstudiante = true;
        estudianteFormulario = new Estudiante
        {
            IdEstudiante = e.IdEstudiante,
            Carnet = e.Carnet,
            NombreCompleto = e.NombreCompleto,
            IdGrupo = e.IdGrupo
        };
        erroresEstudiante.Clear();
        mostrarModalEstudiante = true;
    }

    private bool ValidarEstudiante()
    {
        erroresEstudiante.Clear();

        if (string.IsNullOrWhiteSpace(estudianteFormulario.Carnet))
        {
            erroresEstudiante.Add("El carnet del estudiante es obligatorio.");
        }
        else if (estudianteFormulario.Carnet.Trim().Length < 4)
        {
            erroresEstudiante.Add("El carnet debe tener al menos 4 caracteres.");
        }

        if (string.IsNullOrWhiteSpace(estudianteFormulario.NombreCompleto))
        {
            erroresEstudiante.Add("El nombre completo del estudiante es obligatorio.");
        }
        else if (estudianteFormulario.NombreCompleto.Trim().Length < 5)
        {
            erroresEstudiante.Add("El nombre completo debe tener al menos 5 caracteres.");
        }

        if (estudianteFormulario.IdGrupo == 0)
        {
            erroresEstudiante.Add("Debe seleccionar un grupo académico válido.");
        }

        return !erroresEstudiante.Any();
    }

    private async Task GuardarEstudianteAsync()
    {
        if (!ValidarEstudiante()) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            string carnetLimpio = estudianteFormulario.Carnet.Trim().ToUpperInvariant();
            string nombreLimpio = estudianteFormulario.NombreCompleto.Trim();

            if (esEdicionEstudiante)
            {
                // Validar que no colisione con otro estudiante del mismo grupo
                bool existeOtro = await db.Estudiantes.AnyAsync(e => 
                    e.Carnet == carnetLimpio && 
                    e.IdGrupo == estudianteFormulario.IdGrupo && 
                    e.IdEstudiante != estudianteFormulario.IdEstudiante);

                if (existeOtro)
                {
                    erroresEstudiante.Add($"El carnet '{carnetLimpio}' ya pertenece a otro estudiante en el grupo seleccionado.");
                    return;
                }

                var estDb = await db.Estudiantes.FindAsync(estudianteFormulario.IdEstudiante);
                if (estDb != null)
                {
                    estDb.Carnet = carnetLimpio;
                    estDb.NombreCompleto = nombreLimpio;
                    estDb.IdGrupo = estudianteFormulario.IdGrupo;

                    await db.SaveChangesAsync();
                    mensajeAlerta = $"Estudiante '{estDb.NombreCompleto}' modificado correctamente.";
                    tipoAlerta = "success";
                }
            }
            else
            {
                // Validación 3FN / Restricción de unicidad
                bool existe = await db.Estudiantes.AnyAsync(e => e.Carnet == carnetLimpio && e.IdGrupo == estudianteFormulario.IdGrupo);
                if (existe)
                {
                    erroresEstudiante.Add($"El carnet '{carnetLimpio}' ya está registrado en este grupo.");
                    return;
                }

                db.Estudiantes.Add(new Estudiante
                {
                    Carnet = carnetLimpio,
                    NombreCompleto = nombreLimpio,
                    IdGrupo = estudianteFormulario.IdGrupo
                });

                await db.SaveChangesAsync();
                mensajeAlerta = $"Estudiante '{nombreLimpio}' registrado exitosamente.";
                tipoAlerta = "success";
            }

            mostrarModalEstudiante = false;
            await CargarEstudiantesAsync();
            await CargarGruposAsync();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar estudiante: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

    private async Task EliminarEstudianteAsync(int idEstudiante)
