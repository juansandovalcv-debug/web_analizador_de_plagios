@page "/grupos"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject GestorRespaldos GestorRespaldos
@inject IJSRuntime JS

<PageTitle>Gestión de Grupos y Estudiantes</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-people-fill text-primary me-2"></i>Gestión de Grupos y Estudiantes</h2>
            <p class="text-secondary small m-0">Administración de grupos lectivos, estudiantes, CRUD completo, filtros reactivos y respaldos .zip</p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-outline-primary btn-sm" @onclick="AbrirModalCrearGrupo">
                <i class="bi bi-folder-plus me-1"></i> Nuevo Grupo
            </button>
            <button class="btn btn-primary btn-sm" @onclick="AbrirModalCrearEstudiante">
                <i class="bi bi-person-plus me-1"></i> Agregar Estudiante
            </button>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alert @(tipoAlerta == "success" ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            <i class="bi @(tipoAlerta == "success" ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
            @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
        </div>
    }

    <!-- Pestañas de Navegación -->
    <ul class="nav nav-pills mb-3" role="tablist">
        <li class="nav-item">
            <button class="nav-link @(pestanaActiva == "estudiantes" ? "active" : "")" @onclick="@(() => pestanaActiva = "estudiantes")">
                <i class="bi bi-person-lines-fill me-1"></i> Formulario de Estudiantes (@estudiantesFiltrados.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(pestanaActiva == "grupos" ? "active" : "")" @onclick="@(() => pestanaActiva = "grupos")">
                <i class="bi bi-collection me-1"></i> Formulario de Grupos (@gruposFiltrados.Count)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(pestanaActiva == "masiva" ? "active" : "")" @onclick="@(() => pestanaActiva = "masiva")">
                <i class="bi bi-file-earmark-spreadsheet me-1"></i> Importación Masiva (CSV / Texto)
            </button>
        </li>
        <li class="nav-item">
            <button class="nav-link @(pestanaActiva == "respaldos" ? "active" : "")" @onclick="@(() => pestanaActiva = "respaldos")">
                <i class="bi bi-file-zip me-1"></i> Copias de Seguridad (.ZIP)
            </button>
        </li>
    </ul>

    <!-- VISTA 1: FORMULARIO CRUD & BÚSQUEDA DE ESTUDIANTES -->
    @if (pestanaActiva == "estudiantes")
    {
        <div class="card card-modern mb-4 p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-4">
                    <label class="form-label small fw-semibold text-secondary">Búsqueda Interactiva (Carnet o Nombre)</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar carnet o nombre..." @bind="busquedaEstudianteTexto" @bind:event="oninput" @bind:after="AplicarFiltrosEstudiantes" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Filtrar por Grupo</label>
                    <select class="form-select form-select-sm" @bind="filtroGrupoId" @bind:after="AplicarFiltrosEstudiantes">
                        <option value="0">-- Todos los Grupos --</option>
                        @foreach (var g in listaGrupos)
                        {
                            <option value="@g.IdGrupo">@g.NombreGrupo (Año @g.AnioLectivo - Ciclo @g.ciclo)</option>
                        }
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Ciclo</label>
                    <select class="form-select form-select-sm" @bind="filtroCiclo" @bind:after="AplicarFiltrosEstudiantes">
                        <option value="0">Todos</option>
                        <option value="1">Ciclo 1</option>
                        <option value="2">Ciclo 2</option>
                    </select>
                </div>

                <div class="col-md-2">
                    <label class="form-label small fw-semibold text-secondary">Año Lectivo</label>
                    <input type="number" class="form-control form-control-sm" placeholder="Año..." @bind="filtroAnio" @bind:after="AplicarFiltrosEstudiantes" />
                </div>

                <div class="col-md-1 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ResetFiltrosEstudiantes" title="Limpiar Filtros">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </button>
                </div>
            </div>
        </div>

        <div class="card card-modern p-3">
            @if (cargando)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="text-secondary mt-2">Cargando registros...</p>
                </div>
            }
            else if (!estudiantesFiltrados.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-inbox text-secondary fs-1"></i>
                    <p class="text-secondary mt-2">No se encontraron estudiantes para los filtros seleccionados.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="text-secondary">
                                <th>#</th>
                                <th>Carnet</th>
                                <th>Nombre Completo</th>
                                <th>Grupo Asignado</th>
                                <th>Ciclo / Año</th>
                                <th>Historiales</th>
                                <th class="text-end">Acciones (CRUD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var (est, idx) in estudiantesFiltrados.Select((e, i) => (e, i + 1)))
                            {
                                <tr>
                                    <td class="text-secondary small">@idx</td>
                                    <td><span class="badge bg-secondary font-monospace">@est.Carnet</span></td>
                                    <td class="fw-semibold">@est.NombreCompleto</td>
                                    <td>@(est.Grupo?.NombreGrupo ?? "Sin Grupo")</td>
                                    <td>Ciclo @(est.Grupo?.ciclo ?? 1) - @(est.Grupo?.AnioLectivo ?? DateTime.Now.Year)</td>
                                    <td>
                                        <span class="badge bg-info-subtle text-info border border-info-subtle">
                                            @est.Historiales.Count análisis
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => AbrirModalEditarEstudiante(est)" title="Modificar Estudiante">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarEstudianteAsync(est.IdEstudiante)" title="Eliminar Estudiante">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- VISTA 2: FORMULARIO CRUD & BÚSQUEDA DE GRUPOS -->
    @if (pestanaActiva == "grupos")
    {
        <div class="card card-modern mb-4 p-3">
            <div class="row g-3 align-items-center">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold text-secondary">Búsqueda Interactiva de Grupos</label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" class="form-control" placeholder="Buscar por nombre de sección o asignatura..." @bind="busquedaGrupoTexto" @bind:event="oninput" @bind:after="AplicarFiltrosGrupos" />
                    </div>
                </div>

                <div class="col-md-3">
                    <label class="form-label small fw-semibold text-secondary">Ciclo</label>
                    <select class="form-select form-select-sm" @bind="filtroGrupoCiclo" @bind:after="AplicarFiltrosGrupos">
                        <option value="0">Todos los Ciclos</option>
                        <option value="1">Ciclo 1</option>
                        <option value="2">Ciclo 2</option>
                    </select>
                </div>

                <div class="col-md-3 d-flex align-items-end">
                    <button class="btn btn-outline-secondary btn-sm w-100" @onclick="ResetFiltrosGrupos">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Limpiar Búsqueda
                    </button>
                </div>
            </div>
        </div>

        <div class="card card-modern p-3">
            @if (!gruposFiltrados.Any())
            {
                <div class="text-center py-5">
                    <i class="bi bi-folder-x text-secondary fs-1"></i>
                    <p class="text-secondary mt-2">No se encontraron grupos que coincidan con la búsqueda.</p>
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead>
                            <tr class="text-secondary">
                                <th># ID</th>
                                <th>Nombre del Grupo / Asignatura</th>
                                <th>Año Lectivo</th>
                                <th>Ciclo</th>
                                <th>Estudiantes Inscritos</th>
                                <th class="text-end">Acciones (CRUD)</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var g in gruposFiltrados)
                            {
                                <tr>
                                    <td class="text-secondary font-monospace">#@g.IdGrupo</td>
                                    <td class="fw-semibold">@g.NombreGrupo</td>
                                    <td>@g.AnioLectivo</td>
                                    <td><span class="badge bg-primary">Ciclo @g.ciclo</span></td>
                                    <td>
                                        <span class="badge bg-secondary">@g.Estudiantes.Count alumnos</span>
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-outline-primary btn-sm me-1" @onclick="() => AbrirModalEditarGrupo(g)" title="Modificar Grupo">
                                            <i class="bi bi-pencil-square"></i>
                                        </button>
                                        <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarGrupoAsync(g.IdGrupo)" title="Eliminar Grupo">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    }

    <!-- VISTA 3: IMPORTACIÓN MASIVA -->
    @if (pestanaActiva == "masiva")
    {
        <div class="card card-modern p-4">
            <h5 class="fw-bold mb-3"><i class="bi bi-cloud-arrow-up text-primary me-2"></i>Carga Masiva de Estudiantes</h5>
            <p class="text-secondary small">
                Pega aquí una lista de alumnos o escribe uno por línea en formato: <code>CARNET, NOMBRE COMPLETO</code> (ej. <code>SMIS001224, Juan Pérez López</code>).
            </p>

            <div class="row mb-3">
                <div class="col-md-6">
                    <label class="form-label small fw-semibold">Grupo de Destino:</label>
                    <select class="form-select" @bind="grupoDestinoMasivoId">
                        @foreach (var g in listaGrupos)
                        {
                            <option value="@g.IdGrupo">@g.NombreGrupo (Año @g.AnioLectivo - Ciclo @g.ciclo)</option>
                        }
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label small fw-semibold">Datos de Estudiantes:</label>
                <textarea class="form-control font-monospace" rows="8" placeholder="SMIS000124, Roberto Carlos Sánchez&#10;SMIS000224, María Elena Cruz&#10;SMIS000324, Carlos Alberto Ramos" @bind="textoCargaMasiva"></textarea>
            </div>

            <div class="d-flex justify-content-end gap-2">
                <button class="btn btn-secondary" @onclick="() => textoCargaMasiva = string.Empty">Limpiar</button>
                <button class="btn btn-primary" @onclick="ProcesarCargaMasivaAsync" disabled="@string.IsNullOrWhiteSpace(textoCargaMasiva)">
                    <i class="bi bi-upload me-1"></i> Procesar e Importar Estudiantes
                </button>
            </div>
        </div>
    }

    <!-- VISTA 4: RESPALDOS ZIP -->
    @if (pestanaActiva == "respaldos")
    {
        <div class="row g-4">
            <div class="col-md-6">
                <div class="card card-modern p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-box-arrow-down text-success me-2"></i>Exportar Grupo (.ZIP)</h5>
                    <p class="text-secondary small">
                        Descarga un archivo comprimido .zip que contiene el esquema JSON con la lista de estudiantes, historiales de análisis de plagio y evaluaciones del grupo seleccionado.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Seleccionar Grupo a Exportar:</label>
                        <select class="form-select" @bind="grupoExportarId">
                            @foreach (var g in listaGrupos)
                            {
                                <option value="@g.IdGrupo">@g.NombreGrupo (Total alumnos: @g.Estudiantes.Count)</option>
                            }
                        </select>
                    </div>

                    <button class="btn btn-success mt-auto" @onclick="ExportarZipGrupoAsync" disabled="@(grupoExportarId == 0)">
                        <i class="bi bi-download me-1"></i> Generar y Descargar Respaldo .ZIP
                    </button>
                </div>
            </div>

            <div class="col-md-6">
                <div class="card card-modern p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-box-arrow-in-up text-primary me-2"></i>Restaurar desde Respaldo (.ZIP)</h5>
                    <p class="text-secondary small">
                        Carga un paquete comprimido .zip generado previamente por PlagScan Pro. Se creará un nuevo grupo con todos los registros e historiales preservados.
                    </p>

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Archivo ZIP de Respaldo:</label>
                        <InputFile OnChange="ImportarZipGrupoAsync" class="form-control" accept=".zip" />
                    </div>

                    @if (procesandoZip)
                    {
                        <div class="d-flex align-items-center gap-2 text-primary mt-2">
                            <span class="spinner-border spinner-border-sm"></span>
                            <span>Descomprimiendo y restaurando datos en SQLite...</span>
                        </div>
                    }
                </div>
            </div>
        </div>
    }
</div>

<!-- MODAL FORMULARIO CRUD GRUPOS CON VALIDACIÓN -->
@if (mostrarModalGrupo)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog">
            <div class="modal-content card-modern p-3">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(esEdicionGrupo ? "bi-pencil-square text-primary" : "bi-folder-plus text-success") me-2"></i>
                        @(esEdicionGrupo ? "Modificar Grupo" : "Crear Nuevo Grupo")
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalGrupo = false"></button>
                </div>
                <div class="modal-body">
                    @if (erroresGrupo.Any())
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <ul class="mb-0 ps-3">
                                @foreach (var err in erroresGrupo)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nombre del Grupo / Asignatura: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="Ej: Programación 1 - Sección A" @bind="grupoFormulario.NombreGrupo" />
                        <div class="form-text small text-secondary">Mínimo 3 caracteres.</div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold">Año Lectivo: <span class="text-danger">*</span></label>
                            <input type="number" class="form-control" @bind="grupoFormulario.AnioLectivo" />
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label small fw-semibold">Ciclo: <span class="text-danger">*</span></label>
                            <select class="form-select" @bind="grupoFormulario.ciclo">
                                <option value="1">Ciclo 1</option>
                                <option value="2">Ciclo 2</option>
                            </select>
                        </div>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="() => mostrarModalGrupo = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarGrupoAsync">
                        <i class="bi bi-check2-circle me-1"></i>
                        @(esEdicionGrupo ? "Actualizar Grupo" : "Guardar Grupo")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

<!-- MODAL FORMULARIO CRUD ESTUDIANTES CON VALIDACIÓN -->
@if (mostrarModalEstudiante)
{
    <div class="modal fade show d-block" tabindex="-1" style="background: rgba(0,0,0,0.6);">
        <div class="modal-dialog">
            <div class="modal-content card-modern p-3">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold">
                        <i class="bi @(esEdicionEstudiante ? "bi-pencil-square text-primary" : "bi-person-plus text-success") me-2"></i>
                        @(esEdicionEstudiante ? "Modificar Estudiante" : "Registrar Estudiante")
                    </h5>
                    <button type="button" class="btn-close" @onclick="() => mostrarModalEstudiante = false"></button>
                </div>
                <div class="modal-body">
                    @if (erroresEstudiante.Any())
                    {
                        <div class="alert alert-danger py-2 small mb-3">
                            <ul class="mb-0 ps-3">
                                @foreach (var err in erroresEstudiante)
                                {
                                    <li>@err</li>
                                }
                            </ul>
                        </div>
                    }

                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Carnet de Estudiante: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control font-monospace" placeholder="Ej: SMIS023424" @bind="estudianteFormulario.Carnet" />
                        <div class="form-text small text-secondary">Identificador único. Mínimo 4 caracteres alfanuméricos.</div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Nombre Completo: <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" placeholder="Ej: Juan Carlos Morales" @bind="estudianteFormulario.NombreCompleto" />
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Grupo Asignado: <span class="text-danger">*</span></label>
                        <select class="form-select" @bind="estudianteFormulario.IdGrupo">
                            <option value="0">-- Seleccione Grupo --</option>
                            @foreach (var g in listaGrupos)
                            {
                                <option value="@g.IdGrupo">@g.NombreGrupo</option>
                            }
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-0">
                    <button class="btn btn-secondary" @onclick="() => mostrarModalEstudiante = false">Cancelar</button>
                    <button class="btn btn-primary" @onclick="GuardarEstudianteAsync">
                        <i class="bi bi-check2-circle me-1"></i>
                        @(esEdicionEstudiante ? "Actualizar Estudiante" : "Registrar Estudiante")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Grupo> listaGrupos = new();
    private List<Grupo> gruposFiltrados = new();
    private List<Estudiante> todosEstudiantes = new();
    private List<Estudiante> estudiantesFiltrados = new();

    private string pestanaActiva = "estudiantes";
    private bool cargando = true;
    private string? mensajeAlerta;
    private string tipoAlerta = "success";

    // Búsqueda y filtros Estudiantes
    private int filtroGrupoId = 0;
    private int filtroCiclo = 0;
    private int? filtroAnio;
    private string busquedaEstudianteTexto = string.Empty;

    // Búsqueda y filtros Grupos
    private string busquedaGrupoTexto = string.Empty;
    private int filtroGrupoCiclo = 0;

    // CRUD Grupos
    private bool mostrarModalGrupo = false;
    private bool esEdicionGrupo = false;
    private Grupo grupoFormulario = new() { AnioLectivo = DateTime.Now.Year, ciclo = 1 };
    private List<string> erroresGrupo = new();

    // CRUD Estudiantes
    private bool mostrarModalEstudiante = false;
    private bool esEdicionEstudiante = false;
    private Estudiante estudianteFormulario = new();
    private List<string> erroresEstudiante = new();

    // Importación masiva y respaldos
    private int grupoDestinoMasivoId;
    private string textoCargaMasiva = string.Empty;
    private int grupoExportarId;
    private bool procesandoZip = false;

    protected override async Task OnInitializedAsync()
    {
        await CargarGruposAsync();
        await CargarEstudiantesAsync();
    }

    private async Task CargarGruposAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        listaGrupos = await db.grupos
            .Include(g => g.Estudiantes)
            .OrderByDescending(g => g.AnioLectivo)
            .ThenBy(g => g.ciclo)
            .ToListAsync();

        if (listaGrupos.Any())
        {
            if (grupoDestinoMasivoId == 0) grupoDestinoMasivoId = listaGrupos.First().IdGrupo;
            if (grupoExportarId == 0) grupoExportarId = listaGrupos.First().IdGrupo;
            if (estudianteFormulario.IdGrupo == 0) estudianteFormulario.IdGrupo = listaGrupos.First().IdGrupo;
        }

        AplicarFiltrosGrupos();
    }

    private void AplicarFiltrosGrupos()
    {
        var query = listaGrupos.AsEnumerable();

        if (!string.IsNullOrWhiteSpace(busquedaGrupoTexto))
        {
            string term = busquedaGrupoTexto.Trim().ToLowerInvariant();
            query = query.Where(g => g.NombreGrupo.ToLowerInvariant().Contains(term));
        }

        if (filtroGrupoCiclo > 0)
        {
            query = query.Where(g => g.ciclo == filtroGrupoCiclo);
        }

        gruposFiltrados = query.ToList();
    }

    private void ResetFiltrosGrupos()
    {
        busquedaGrupoTexto = string.Empty;
        filtroGrupoCiclo = 0;
        AplicarFiltrosGrupos();
    }

    private async Task CargarEstudiantesAsync()
    {
        cargando = true;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            todosEstudiantes = await db.Estudiantes
                .Include(e => e.Grupo)
                .Include(e => e.Historiales)
                .OrderBy(e => e.NombreCompleto)
                .ToListAsync();

            AplicarFiltrosEstudiantes();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al cargar estudiantes: {ex.Message}";
            tipoAlerta = "danger";
        }
        finally
        {
            cargando = false;
        }
    }

    private void AplicarFiltrosEstudiantes()
    {
        var filtrados = todosEstudiantes.AsEnumerable();

        if (filtroGrupoId > 0)
        {
            filtrados = filtrados.Where(e => e.IdGrupo == filtroGrupoId);
        }

        if (filtroCiclo > 0)
        {
            filtrados = filtrados.Where(e => e.Grupo != null && e.Grupo.ciclo == filtroCiclo);
        }

        if (filtroAnio.HasValue && filtroAnio.Value > 0)
        {
            filtrados = filtrados.Where(e => e.Grupo != null && e.Grupo.AnioLectivo == filtroAnio.Value);
        }

        if (!string.IsNullOrWhiteSpace(busquedaEstudianteTexto))
        {
            string term = busquedaEstudianteTexto.Trim().ToLowerInvariant();
            filtrados = filtrados.Where(e =>
                e.Carnet.ToLowerInvariant().Contains(term) ||
                e.NombreCompleto.ToLowerInvariant().Contains(term));
        }

        estudiantesFiltrados = filtrados.ToList();
    }

    private void ResetFiltrosEstudiantes()
    {
        filtroGrupoId = 0;
        filtroCiclo = 0;
        filtroAnio = null;
        busquedaEstudianteTexto = string.Empty;
        AplicarFiltrosEstudiantes();
    }

    // OPERACIONES CRUD GRUPOS
    private void AbrirModalCrearGrupo()
    {
        esEdicionGrupo = false;
        grupoFormulario = new Grupo { AnioLectivo = DateTime.Now.Year, ciclo = 1 };
        erroresGrupo.Clear();
        mostrarModalGrupo = true;
    }

    private void AbrirModalEditarGrupo(Grupo g)
    {
        esEdicionGrupo = true;
        grupoFormulario = new Grupo
        {
            IdGrupo = g.IdGrupo,
            NombreGrupo = g.NombreGrupo,
            AnioLectivo = g.AnioLectivo,
            ciclo = g.ciclo
        };
        erroresGrupo.Clear();
        mostrarModalGrupo = true;
    }

    private bool ValidarGrupo()
    {
        erroresGrupo.Clear();

        if (string.IsNullOrWhiteSpace(grupoFormulario.NombreGrupo))
        {
            erroresGrupo.Add("El nombre del grupo es obligatorio.");
        }
        else if (grupoFormulario.NombreGrupo.Trim().Length < 3)
        {
            erroresGrupo.Add("El nombre del grupo debe tener al menos 3 caracteres.");
        }

        if (grupoFormulario.AnioLectivo < 2000 || grupoFormulario.AnioLectivo > 2100)
        {
            erroresGrupo.Add("El año lectivo debe estar en un rango válido (2000 - 2100).");
        }

        if (grupoFormulario.ciclo < 1 || grupoFormulario.ciclo > 2)
        {
            erroresGrupo.Add("El ciclo académico debe ser 1 o 2.");
        }

        return !erroresGrupo.Any();
    }

    private async Task GuardarGrupoAsync()
    {
        if (!ValidarGrupo()) return;

        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();

            if (esEdicionGrupo)
            {
                var gDb = await db.grupos.FindAsync(grupoFormulario.IdGrupo);
                if (gDb != null)
                {
                    gDb.NombreGrupo = grupoFormulario.NombreGrupo.Trim();
                    gDb.AnioLectivo = grupoFormulario.AnioLectivo;
                    gDb.ciclo = grupoFormulario.ciclo;

                    await db.SaveChangesAsync();
                    mensajeAlerta = $"Grupo '{gDb.NombreGrupo}' modificado exitosamente.";
                    tipoAlerta = "success";
                }
            }
            else
            {
                db.grupos.Add(new Grupo
                {
                    NombreGrupo = grupoFormulario.NombreGrupo.Trim(),
                    AnioLectivo = grupoFormulario.AnioLectivo,
                    ciclo = grupoFormulario.ciclo
                });
                await db.SaveChangesAsync();

                mensajeAlerta = $"Grupo '{grupoFormulario.NombreGrupo}' creado exitosamente.";
                tipoAlerta = "success";
            }

            mostrarModalGrupo = false;
            await CargarGruposAsync();
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al procesar grupo: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

    private async Task EliminarGrupoAsync(int idGrupo)
    {
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var g = await db.grupos.Include(x => x.Estudiantes).FirstOrDefaultAsync(x => x.IdGrupo == idGrupo);
            if (g != null)
            {
                if (g.Estudiantes.Any())
                {
                    mensajeAlerta = $"No se puede eliminar el grupo '{g.NombreGrupo}' porque contiene {g.Estudiantes.Count} alumnos inscritos. Elimine los alumnos primero.";
                    tipoAlerta = "danger";
                    return;
                }

                db.grupos.Remove(g);
                await db.SaveChangesAsync();

                mensajeAlerta = $"Grupo eliminado exitosamente.";
                tipoAlerta = "success";
                await CargarGruposAsync();
            }
        }
        catch (Exception ex)
        {
            mensajeAlerta = $"Error al eliminar grupo: {ex.Message}";
            tipoAlerta = "danger";
        }
    }

