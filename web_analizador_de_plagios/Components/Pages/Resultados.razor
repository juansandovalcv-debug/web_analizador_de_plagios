@page "/resultados"
@rendermode InteractiveServer
@inject IDbContextFactory<AppDbContext> DbFactory
@inject GeneradorQuizDefensa GeneradorQuiz
@inject DetectorIAPatrones DetectorIA
@inject InspectorMetadatos InspectorMetadatos
@inject IJSRuntime JS

<PageTitle>Resultados & Cuestionario Anti-Fraude</PageTitle>

<div class="container-fluid p-0">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
        <div>
            <h2 class="fw-bold m-0"><i class="bi bi-mortarboard-fill text-primary me-2"></i>Resultados & Cuestionario Anti-Fraude</h2>
            <p class="text-secondary small m-0">Inspección forense de metadatos de Windows, métricas de plagio e IA y generación de Quiz de Defensa Oral</p>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(mensajeAlerta))
    {
        <div class="alert @(tipoAlerta == "success" ? "alert-success" : "alert-danger") alert-dismissible fade show" role="alert">
            <i class="bi @(tipoAlerta == "success" ? "bi-check-circle" : "bi-exclamation-triangle") me-2"></i>
            @mensajeAlerta
            <button type="button" class="btn-close" @onclick="() => mensajeAlerta = null"></button>
        </div>
    }

    <!-- Selector de Historial / Evaluación Reciente -->
    <div class="card card-modern p-3 mb-4">
        <div class="row g-3 align-items-center">
            <div class="col-md-6">
                <label class="form-label small fw-semibold text-secondary">Seleccionar Registro de Análisis para Detalle:</label>
                <select class="form-select" @bind="idHistorialSeleccionado" @bind:after="CargarDetalleHistorialAsync">
                    <option value="0">-- Seleccione una evaluación analizada --</option>
                    @foreach (var h in listaHistoriales)
                    {
                        <option value="@h.IdHistorial">
                            #@h.IdHistorial - @(h.Estudiante?.NombreCompleto ?? "Estudiante") | @(h.Evaluacion?.NombreTarea ?? "Evaluación") (Plagio: @h.PorcentajePlagio%, IA: @h.PorcentajeIA%)
                        </option>
                    }
                </select>
            </div>

            <div class="col-md-6 text-md-end">
                <span class="text-secondary small">Total registros disponibles: @listaHistoriales.Count</span>
            </div>
        </div>
    </div>

    @if (historialActual != null)
    {
        <div class="row g-4 mb-4">
            <!-- Métricas de Plagio e IA -->
            <div class="col-md-6">
                <div class="card card-modern p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-speedometer2 text-danger me-2"></i>Métricas de Autenticidad</h5>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold">Porcentaje de Similitud (Plagio de Código):</span>
                            <span class="fw-bold text-danger fs-5">@historialActual.PorcentajePlagio%</span>
                        </div>
                        <div class="progress progress-thin">
                            <div class="progress-bar bg-danger" role="progressbar" style="width: @historialActual.PorcentajePlagio%"></div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <div class="d-flex justify-content-between mb-1">
                            <span class="fw-semibold">Probabilidad de Generación por IA:</span>
                            <span class="fw-bold text-warning fs-5">@historialActual.PorcentajeIA%</span>
                        </div>
                        <div class="progress progress-thin">
                            <div class="progress-bar bg-warning" role="progressbar" style="width: @historialActual.PorcentajeIA%"></div>
                        </div>
                    </div>

                    <div class="p-3 rounded bg-body-tertiary border">
                        <h6 class="fw-bold small mb-2"><i class="bi bi-info-circle me-1"></i>Información del Estudiante & Entrega</h6>
                        <div class="row small g-2">
                            <div class="col-6"><strong>Estudiante:</strong> @(historialActual.Estudiante?.NombreCompleto ?? "N/A")</div>
                            <div class="col-6"><strong>Carnet:</strong> @(historialActual.Estudiante?.Carnet ?? "N/A")</div>
                            <div class="col-6"><strong>Evaluación:</strong> @(historialActual.Evaluacion?.NombreTarea ?? "N/A")</div>
                            <div class="col-6"><strong>Cómputo:</strong> Cómputo @(historialActual.Evaluacion?.Computo ?? 1)</div>
                            <div class="col-12"><strong>Archivo:</strong> <code>@historialActual.RutaArchivo</code></div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Inspector Visual de Metadatos de Windows -->
            <div class="col-md-6">
                <div class="card card-modern p-4 h-100">
                    <h5 class="fw-bold mb-3"><i class="bi bi-windows text-info me-2"></i>Inspector Forense de Metadatos de Windows</h5>
                    
                    @if (metadatosParseados != null)
                    {
                        <div class="table-responsive">
                            <table class="table table-sm table-borderless small mb-0">
                                <tbody>
                                    <tr>
                                        <th class="text-secondary">Nombre de Archivo:</th>
                                        <td class="font-monospace">@metadatosParseados.NombreArchivo</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Tamaño en Disco:</th>
                                        <td>@metadatosParseados.TamanoFormateado (@metadatosParseados.TamanoBytes bytes)</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Propietario / Cuenta OS:</th>
                                        <td><span class="badge bg-secondary font-monospace">@metadatosParseados.Propietario</span></td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Codificación Detectada:</th>
                                        <td>
                                            <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                @metadatosParseados.CodificacionDetectada
                                            </span>
                                            @(metadatosParseados.ContieneBOM ? " (BOM Presente)" : "")
                                        </td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Fecha Creación (OS):</th>
                                        <td>@(metadatosParseados.FechaCreacionUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "No disponible")</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Fecha Modificación (OS):</th>
                                        <td>@(metadatosParseados.FechaModificacionUtc?.ToLocalTime().ToString("dd/MM/yyyy HH:mm:ss") ?? "No disponible")</td>
                                    </tr>
                                    <tr>
                                        <th class="text-secondary">Total Líneas / Caracteres:</th>
                                        <td>@metadatosParseados.TotalLineas líneas / @metadatosParseados.TotalCaracteres caracteres</td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        @if (metadatosParseados.Advertencias.Any())
                        {
                            <div class="mt-3 p-2 rounded bg-danger-subtle text-danger border border-danger-subtle small">
                                <i class="bi bi-shield-fill-exclamation me-1"></i>
                                @foreach (var adv in metadatosParseados.Advertencias)
                                {
                                    <div>@adv</div>
                                }
                            </div>
                        }
                    }
                    else
                    {
                        <p class="text-secondary small">Sin metadatos JSON disponibles para este registro.</p>
                    }
                </div>
            </div>
        </div>

        <!-- Módulo Generador y Descargador de Quiz de Defensa Oral -->
        <div class="card card-modern p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h4 class="fw-bold m-0"><i class="bi bi-patch-question-fill text-success me-2"></i>Quiz de Defensa Oral Personalizado</h4>
                    <p class="text-secondary small m-0">Generación de 3 a 5 preguntas de defensa algorítmica basadas en la estructura del código analizado</p>
                </div>

                <div class="d-flex gap-2">
                    <button class="btn btn-primary" @onclick="GenerarFichaQuiz">
                        <i class="bi bi-magic me-1"></i> Generar Preguntas
                    </button>
                    @if (fichaQuizGenerada != null)
                    {
                        <button class="btn btn-outline-success" @onclick="DescargarFichaTexto">
                            <i class="bi bi-file-earmark-arrow-down me-1"></i> Descargar Ficha (.TXT)
                        </button>
                    }
                </div>
            </div>

            @if (fichaQuizGenerada != null)
            {
                <div class="row g-3">
                    @foreach (var q in fichaQuizGenerada.Preguntas)
                    {
                        <div class="col-12">
                            <div class="p-3 rounded bg-body-tertiary border">
                                <div class="d-flex justify-content-between align-items-center mb-2">
                                    <span class="badge bg-primary">Pregunta #@q.Numero: @q.Categoria</span>
                                    <span class="text-secondary small">Evaluación Oral</span>
                                </div>
                                <h6 class="fw-bold mb-2">@q.Pregunta</h6>
                                @if (!string.IsNullOrWhiteSpace(q.FragmentoCodigo))
                                {
                                    <div class="bg-dark p-2 rounded mb-2 font-monospace small text-light border">
                                        <code>@q.FragmentoCodigo</code>
                                    </div>
                                }
                                <div class="small text-secondary">
                                    <strong>Criterio para el Docente:</strong> @q.JustificacionTecnica
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-secondary">
                    <i class="bi bi-chat-square-quote fs-2"></i>
                    <p class="mt-2 mb-0">Haz clic en <strong>Generar Preguntas</strong> para crear la ficha de defensa oral para este estudiante.</p>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card card-modern p-5 text-center">
            <i class="bi bi-clipboard2-check fs-1 text-secondary"></i>
            <p class="text-secondary mt-2">Selecciona un análisis arriba para visualizar sus métricas, inspección forense y cuestionario anti-fraude.</p>
        </div>
    }
</div>

@code {
    private List<HistorialAnalisis> listaHistoriales = new();
    private int idHistorialSeleccionado = 0;
    private HistorialAnalisis? historialActual;
    private InformacionMetadatos? metadatosParseados;
    private FichaQuizDefensa? fichaQuizGenerada;

    private string? mensajeAlerta;
    private string tipoAlerta = "success";

    protected override async Task OnInitializedAsync()
    {
        await CargarHistorialesAsync();
    }

    private async Task CargarHistorialesAsync()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        listaHistoriales = await db.Evaluaciones
            .Include(h => h.Estudiante)
            .Include(h => h.Evaluacion)
            .OrderByDescending(h => h.IdHistorial)
            .ToListAsync();

        if (listaHistoriales.Any())
        {
            idHistorialSeleccionado = listaHistoriales.First().IdHistorial;
            await CargarDetalleHistorialAsync();
        }
    }

    private async Task CargarDetalleHistorialAsync()
    {
        fichaQuizGenerada = null;
        if (idHistorialSeleccionado == 0)
        {
            historialActual = null;
            metadatosParseados = null;
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        historialActual = await db.Evaluaciones
            .Include(h => h.Estudiante)
            .Include(h => h.Evaluacion)
            .FirstOrDefaultAsync(h => h.IdHistorial == idHistorialSeleccionado);

        if (historialActual != null && !string.IsNullOrWhiteSpace(historialActual.MetadatosJson))
        {
            try
            {
                metadatosParseados = System.Text.Json.JsonSerializer.Deserialize<InformacionMetadatos>(historialActual.MetadatosJson);
            }
            catch
            {
                metadatosParseados = new InformacionMetadatos { NombreArchivo = historialActual.RutaArchivo };
            }
        }
    }

    private void GenerarFichaQuiz()
    {
        if (historialActual == null) return;

        // Si tenemos el código fuente en disco o simulado a través del nombre de archivo y metadatos
        string codigoSnippet = $"// Entrega de: {historialActual.Estudiante?.NombreCompleto}\n" +
                               $"// Archivo: {historialActual.RutaArchivo}\n" +
                               "public static int CalcularSecuencia(int[] datos) {\n" +
                               "    int suma = 0;\n" +
                               "    for (int i = 0; i < datos.Length; i++) {\n" +
                               "        if (datos[i] > 0) suma += datos[i];\n" +
                               "    }\n" +
                               "    return suma;\n" +
                               "}";

        var patronesIA = new List<string>();
        if (historialActual.PorcentajeIA >= 40)
        {
            patronesIA.Add("Alta coincidencia de estructuras canónicas generadas por asistente LLM");
        }

        fichaQuizGenerada = GeneradorQuiz.GenerarPreguntas(
            codigoSnippet,
            historialActual.Estudiante?.NombreCompleto ?? "Estudiante",
            historialActual.Estudiante?.Carnet ?? "N/A",
            historialActual.RutaArchivo,
            patronesIA
        );

        mensajeAlerta = "Cuestionario de 5 preguntas de defensa oral generado exitosamente.";
        tipoAlerta = "success";
    }

    private async Task DescargarFichaTexto()
    {
        if (fichaQuizGenerada == null) return;

        string textoFicha = GeneradorQuiz.GenerarTextoFicha(fichaQuizGenerada);
        string nombreArchivo = $"ficha_defensa_{fichaQuizGenerada.Carnet}_{DateTime.Now:yyyyMMdd}.txt";

        await JS.InvokeVoidAsync("descargarArchivo", nombreArchivo, textoFicha);
    }
}
